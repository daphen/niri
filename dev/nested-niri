#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

nested_pid=""
watcher_pid=""

stop_nested() {
    if [[ -n "$nested_pid" ]] && kill -0 "$nested_pid" 2>/dev/null; then
        kill -- "-$nested_pid" 2>/dev/null || true
        wait "$nested_pid" 2>/dev/null || true
    fi
    nested_pid=""
}

start_nested() {
    setsid target/debug/niri --config dev/nested.kdl &
    nested_pid=$!
}

restart_nested() {
    stop_nested
    start_nested
}

cleanup() {
    trap - EXIT INT TERM USR1
    if [[ -n "$watcher_pid" ]] && kill -0 "$watcher_pid" 2>/dev/null; then
        kill "$watcher_pid" 2>/dev/null || true
        wait "$watcher_pid" 2>/dev/null || true
    fi
    stop_nested
}

trap cleanup EXIT INT TERM
trap restart_nested USR1

cargo build --bin niri
target/debug/niri validate --config dev/nested.kdl
start_nested

export NESTED_NIRI_RUNNER_PID=$$
watchexec --postpone \
    --watch src \
    --watch niri-config/src \
    --watch niri-ipc/src \
    --watch build.rs \
    --watch Cargo.toml \
    --watch Cargo.lock \
    --exts rs,toml,lock \
    --shell none \
    -- bash -c 'cargo build --bin niri && kill -USR1 "$NESTED_NIRI_RUNNER_PID"' &
watcher_pid=$!

while kill -0 "$watcher_pid" 2>/dev/null; do
    wait "$watcher_pid" 2>/dev/null || true
done
