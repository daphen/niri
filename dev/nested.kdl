hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

layout {
    gaps 12
    default-column-width { proportion 0.4; }
    center-focused-column "always"
    plane-pan-sensitivity 6.0
    plane-pan-zoom 0.8
}

animations {
    plane-pan {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}

spawn-at-startup "foot" "-a" "fixture-alpha" "-T" "Alpha 1" "sleep" "infinity"
spawn-at-startup "foot" "-a" "fixture-alpha" "-T" "Alpha 2" "sleep" "infinity"
spawn-at-startup "foot" "-a" "fixture-alpha" "-T" "Alpha 3" "sleep" "infinity"
spawn-at-startup "foot" "-a" "fixture-beta" "-T" "Beta 1" "sleep" "infinity"
spawn-at-startup "foot" "-a" "fixture-beta" "-T" "Beta 2" "sleep" "infinity"
spawn-at-startup "foot" "-a" "fixture-beta" "-T" "Beta 3" "sleep" "infinity"
spawn-at-startup "foot" "-a" "fixture-gamma" "-T" "Gamma 1" "sleep" "infinity"
spawn-at-startup "foot" "-a" "fixture-gamma" "-T" "Gamma 2" "sleep" "infinity"
spawn-at-startup "foot" "-a" "fixture-gamma" "-T" "Gamma 3" "sleep" "infinity"
spawn-at-startup "sh" "-c" "sleep 1; niri msg action set-column-width '30%'; niri msg action focus-column-left; niri msg action set-column-width '60%'; niri msg action consume-window-into-column"

binds {
    Super+Return { spawn "foot" "-a" "niri-fixture" "-T" "Fixture" "sleep" "infinity"; }
    Super+Q repeat=false { close-window; }
    Super+O repeat=false { toggle-overview; }
    Super+Slash repeat=false { spawn-sh "for session in $(loginctl list-sessions --no-legend | awk '{print $1}'); do if [ \"$(loginctl show-session \"$session\" -p Name --value)\" = \"$USER\" ] && [ \"$(loginctl show-session \"$session\" -p VTNr --value)\" = 1 ]; then exec loginctl activate \"$session\"; fi; done"; }

    Super+H { focus-column-left; }
    Super+J { focus-window-down; }
    Super+K { focus-window-up; }
    Super+L { focus-column-right; }

    Super+Shift+H { move-column-left; }
    Super+Shift+J { move-window-down; }
    Super+Shift+K { move-window-up; }
    Super+Shift+L { move-column-right; }

    Super+Shift+E { quit skip-confirmation=true; }
}
